{
  "schemaVersion": 1,
  "id": "kimiko",
  "version": "1.5-privacy",
  "name": "Kimiko Privacy",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "recovery.privacy.PrivacyPreLaunch"
    ],
    "main": [
      "rtx.kimiko.Kimiko"
    ],
    "client": [
      "rtx.kimiko.Kimiko"
    ]
  },
  "mixins": [
    "kimiko.mixins.json",
    "kimiko.privacy.mixins.json"
  ],
  "accessWidener": "kimiko.accesswidener",
  "jars": [
    {
      "file": "META-INF/jars/Concentus-1.0.1.jar"
    },
    {
      "file": "META-INF/jars/core-3.8.3.jar"
    },
    {
      "file": "META-INF/jars/geckolib-fabric-1.21.11-5.4.5.jar"
    },
    {
      "file": "META-INF/jars/jna-5.15.0.jar"
    },
    {
      "file": "META-INF/jars/opus4j-2.1.3.jar"
    },
    {
      "file": "META-INF/jars/rnnoise4j-2.1.3.jar"
    },
    {
      "file": "META-INF/jars/speex4j-1.0.3.jar"
    },
    {
      "file": "META-INF/jars/toml-3.8.3.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  }
