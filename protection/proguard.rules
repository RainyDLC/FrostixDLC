-dontshrink
-dontoptimize
-dontwarn **

-keep class fun.newrar.Client { *; }
-keep class fun.newrar.RainyDlcLoader { *; }
-keep class fun.newrar.RainyDlcPreLaunch { *; }
-keep class fun.newrar.core.ClientMain { public static void init(fun.newrar.Client); }

-keep class fun.newrar.mixin.** { *; }
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod,MethodParameters,RuntimeVisibleAnnotations,RuntimeInvisibleAnnotations,RuntimeVisibleParameterAnnotations,RuntimeInvisibleParameterAnnotations,AnnotationDefault

-keep class ** extends com.sun.jna.Structure { *; }
-keep class ** extends com.sun.jna.Callback { *; }
-keep class ** implements com.sun.jna.Library { *; }

-keepclassmembers enum ** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
    <fields>;
}

-keep class fun.newrar.utils.annotation.IMinecraft { *; }
-keep class fun.newrar.utils.player.ITimerSpeed { *; }

-keepclassmembers class ** {
    @fun.newrar.manager.events.orbit.EventHandler *;
}
-keep class fun.newrar.manager.events.** { *; }

-keepclassmembers class fun.newrar.manager.event_impl.** {
    <init>(...);
    public <methods>;
    public <fields>;
}

-keepclassmembers class * {
    *** method_*(...);
    *** field_*;
}

-keepclassmembers class * extends net.minecraft.class_437 {
    <methods>;
}

-keepclassmembers class * extends net.minecraft.client.gui.screen.Screen {
    <methods>;
}

-keepclassmembers class * implements net.minecraft.class_364 {
    <methods>;
}

-keepclassmembers class * implements net.minecraft.class_4068 {
    <methods>;
}

-allowaccessmodification
-obfuscationdictionary dict-class.txt
-classobfuscationdictionary dict-member.txt
-packageobfuscationdictionary dict-class.txt

