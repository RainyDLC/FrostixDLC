# ── Supabase (https://supabase.com → New project, бесплатный тариф) ──
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# ⚠️ ТОЛЬКО сервер. Никогда не ставь префикс NEXT_PUBLIC — ключ даёт полный доступ к БД.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Техработы на уровне хостинга (перекрывает переключатель в админке) ──
# Поставь true в Vercel → Settings → Environment Variables, чтобы закрыть сайт.
SITE_MAINTENANCE=false
